<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>DataMockerSample</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
    <ApplicationId Condition="'$(TargetFramework)' == 'net10.0-ios'">com.epam.DataMockerSample</ApplicationId>
    <ApplicationId Condition="'$(TargetFramework)' == 'net10.0-android'">com.epam.DataMockerSample</ApplicationId>
    <EnableDefaultProgramMain Condition="'$(TargetFramework)' == 'net10.0-ios'">true</EnableDefaultProgramMain>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DataMocker.Mock" Version="1.0.12" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.30" />
    <PackageReference Include="Autofac" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataMockerSample.Common\DataMockerSample.Common.csproj" />
    <ProjectReference Include="..\DataMockerSample.Mock\DataMockerSample.Mock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\AppResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\AppResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AppResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\AppResources.ru.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>
</Project>